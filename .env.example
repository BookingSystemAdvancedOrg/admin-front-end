# Kopiera den här filen till .env och fyll i dina riktiga värden.
# .env är git-ignorerad och ska ALDRIG committas.
# Se docs/COGNITO-SETUP.md för var du hittar värdena i AWS Console.

# Cognito User Pool ID (AWS Console -> Cognito -> User pools -> din pool -> Overview)
# Format: <region>_XXXXXXXXX, t.ex. eu-north-1_Ab12Cd34E
VITE_COGNITO_USER_POOL_ID=

# App client ID (samma pool -> App integration -> App clients)
# En publik klient UTAN client secret. Format: lång sträng av bokstäver/siffror.
VITE_COGNITO_CLIENT_ID=

# (Valfritt, för framtida API-anrop) Bas-URL till ert API, t.ex. API Gateway:
# VITE_API_BASE_URL=https://xxxxxx.execute-api.eu-north-1.amazonaws.com/prod
