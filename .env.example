# Kopiera den här filen till .env och fyll i dina riktiga värden.
# .env är git-ignorerad och ska ALDRIG committas.
# Se docs/API-OCH-NYCKLAR.md för var du hittar värdena i AWS Console.

# Cognito User Pool ID (AWS Console -> Cognito -> User pools -> din pool -> Overview)
# Format: <region>_XXXXXXXXX, t.ex. eu-north-1_Ab12Cd34E
# App client ID (samma pool -> App integration -> App clients -> Client ID)
# Klienten ska vara publik, UTAN client secret.
VITE_COGNITO_USER_POOL_ID_DEV=
VITE_COGNITO_CLIENT_ID_DEV=

VITE_COGNITO_USER_POOL_ID_PROD=
VITE_COGNITO_CLIENT_ID_PROD=

# Vilken av poolerna ovan som används. Utan den här raden körs _DEV.
# VITE_COGNITO_ENV=prod

# (Valfritt, för framtida API-anrop) Bas-URL till ert API, t.ex. API Gateway:
# VITE_API_BASE_URL=https://xxxxxx.execute-api.eu-north-1.amazonaws.com/prod
