AWS_REGION=eu-north-1

# --- dev ---------------------------------------------------------------
OIDC_ROLE_ARN_DEV=arn:aws:iam::877653167825:role/dev-admin-front-end-deploy-role
S3_BUCKET_DEV=dev-admin-front-end-asset-877653167825
CLOUDFRONT_DISTRIBUTION_ID_DEV=E1U8E9DQ9XT2AW
VITE_API_BASE_URL_DEV=https://dh2m5ildm7.execute-api.eu-north-1.amazonaws.com
# CloudFront-domänen som serverar menybild-bucketen (dev-menu-image-...) under
# /menu-images/*. Bara domänen: imageKey bär redan prefixet menu-images/.
# API:t returnerar bara S3-nyckeln; utan den här visas platshållare i menyn.
VITE_MENU_IMAGE_BASE_URL_DEV=https://d34fv5yun0ld7v.cloudfront.net

# --- prod ----------------------------------------------------------------
OIDC_ROLE_ARN_PROD=arn:aws:iam::343695380960:role/admin-front-end-deploy-role
S3_BUCKET_PROD=admin-front-end-asset-343695380960
CLOUDFRONT_DISTRIBUTION_ID_PROD=E2IC29U1O6NUIA
# REPLACE_ME once the prod HTTP API is deployed - until then, prod builds
# ship without a configured API (apiFetch throws "VITE_API_BASE_URL är inte
# satt", login shows "Kunde inte nå inloggningstjänsten").
VITE_API_BASE_URL_PROD=https://9md43vqnp1.execute-api.eu-north-1.amazonaws.com
VITE_MENU_IMAGE_BASE_URL_PROD=https://restaurant.booqy.se

# Post-deploy smoke test (scripts/smoke-test.sh, source of truth in
# infrastructure/ci). SMOKE_HOST: a restaurant host that always exists
# (GET /site-config?host= must answer 200); empty = an unknown host must
# answer 404 instead. SMOKE_SITES: name=url pairs, each must serve the app
# shell and its script bundle. ALERT_TOPIC_ARN: where a failed smoke test
# is emailed (the deploy role needs sns:Publish on it).
ALERT_TOPIC_ARN_DEV=arn:aws:sns:eu-north-1:877653167825:dev-platform-alerts
ALERT_TOPIC_ARN_PROD=arn:aws:sns:eu-north-1:343695380960:platform-alerts
SMOKE_HOST_DEV=
SMOKE_HOST_PROD=
SMOKE_SITES_DEV="customer=https://d3kaislpxcbglq.cloudfront.net admin=https://restaurang.dev.booqy.se console=https://admin.dev.booqy.se"
SMOKE_SITES_PROD="customer=https://d3uasj29icofcs.cloudfront.net admin=https://restaurang.booqy.se console=https://admin.booqy.se"
